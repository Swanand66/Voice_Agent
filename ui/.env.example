# Leave blank for local dev (uses Vite proxy → http://localhost:7860)
# Set to your deployed bot URL in production, e.g.:
# VITE_BOT_URL=https://your-bot.onrender.com
VITE_BOT_URL=

# TURN server — required when the bot is behind a proxy that blocks UDP
# (Render, most PaaS platforms). Get free credentials at metered.ca.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
